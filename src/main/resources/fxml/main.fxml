<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.timafe.triptale.ui.MainController"
            prefWidth="900" prefHeight="600">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem text="New Trip…" onAction="#onNewTrip"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Export Diary…" onAction="#onExportDiary"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Exit" onAction="#onExit"/>
                        </items>
                    </Menu>
                    <Menu text="Remote">
                        <items>
                            <MenuItem text="Pull" onAction="#onPull"/>
                            <MenuItem text="Push" onAction="#onPush"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Remote Info…" onAction="#onRemoteInfo"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="About" onAction="#onAbout"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="Trip:"/>
                <ComboBox fx:id="tripCombo" prefWidth="240"/>
                <Button text="ⓘ" onAction="#onTripDetails">
                    <tooltip><Tooltip text="Trip details"/></tooltip>
                </Button>
                <Button fx:id="firstDayButton" text="⏮" onAction="#onFirstDay">
                    <tooltip><Tooltip text="Go to day 1"/></tooltip>
                </Button>
                <Button fx:id="prevDayButton" text="◀" onAction="#onPrevDay"/>
                <DatePicker fx:id="datePicker"/>
                <Button text="▶" onAction="#onNextDay"/>
                <Button fx:id="todayButton" text="◉" onAction="#onToday">
                    <tooltip><Tooltip text="Go to today"/></tooltip>
                </Button>
                <Label fx:id="tourDayLabel"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="0" right="10" bottom="10" left="10"/></padding>
            <GridPane hgap="10" vgap="6">
                <Label text="Distance (km):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="distanceField" prefWidth="120" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Altitude (m):" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="altField" prefWidth="120" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                <Label text="Route:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="routeField" prefWidth="360" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
            </GridPane>
            <Label text="Notes"/>
            <TextArea fx:id="notesArea" VBox.vgrow="ALWAYS" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label fx:id="statusLabel"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="saveButton" text="Save" onAction="#onSave" defaultButton="true"/>
                <Button fx:id="commitButton" text="Commit (0)" onAction="#onCommit" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
